set(RC_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/vendor/rcheevos")
file(GLOB RC_CORE CONFIGURE_DEPENDS "${RC_ROOT}/src/rcheevos/*.c" "${RC_ROOT}/src/rapi/*.c" "${RC_ROOT}/src/rhash/*.c")
add_library(yi_rcheevos STATIC ${RC_CORE} "${RC_ROOT}/src/rc_client.c"
  "${RC_ROOT}/src/rc_compat.c" "${RC_ROOT}/src/rc_util.c" "${RC_ROOT}/src/rc_version.c")
target_include_directories(yi_rcheevos PUBLIC "${RC_ROOT}/include" PRIVATE "${RC_ROOT}/src")
target_compile_definitions(yi_rcheevos PRIVATE RC_DISABLE_LUA RC_CLIENT_SUPPORTS_HASH)
add_library(yi_ra_core STATIC src/ra/client/client.cpp src/ra/client/windows_services.cpp)
target_include_directories(yi_ra_core PUBLIC src/ra src/ra/client)
target_link_libraries(yi_ra_core PUBLIC yi_rcheevos winhttp advapi32 crypt32)
if(MINGW)
  target_link_libraries(yi_ra_core PUBLIC winpthread)
endif()
if(YI_BUILD_PLAY)
  target_sources(yoshis_island_recomp PRIVATE src/ra/yi_ra.cpp)
  target_compile_definitions(yoshis_island_recomp PRIVATE YI_ONLINE_RA=1)
  target_link_libraries(yoshis_island_recomp PRIVATE yi_ra_core gdi32)
  include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/YiLauncherPanel.cmake)
  yi_launcher_panel(yoshis_island_recomp YiRaDrawPanel)
endif()
if(YI_BUILD_TESTS)
  add_executable(ra_preferences_test tests/ra/preferences_test.cpp)
  target_include_directories(ra_preferences_test PRIVATE src/ra)
  yi_set_link_options(ra_preferences_test)
  add_test(NAME ra_preferences_contract COMMAND ra_preferences_test "${CMAKE_CURRENT_BINARY_DIR}/ra-preferences-fixture")
  add_executable(yi_ra_test tests/ra/client_test.cpp)
  add_executable(ra_lifecycle_test tests/ra/lifecycle_test.cpp)
  target_include_directories(ra_lifecycle_test PRIVATE tests/ra)
  target_link_libraries(ra_lifecycle_test PRIVATE yi_ra_core)
  yi_set_link_options(ra_lifecycle_test)
  add_test(NAME ra_account_lifecycle_contract COMMAND ra_lifecycle_test)
  target_include_directories(yi_ra_test PRIVATE tests/ra)
  target_link_libraries(yi_ra_test PRIVATE yi_ra_core)
  set(imgui "${RECOMP_UI_ROOT}/src/third_party/imgui")
  add_executable(yi_ra_ui_test tests/ra/ui_test.cpp src/ra/yi_ra.cpp
    "${imgui}/imgui.cpp" "${imgui}/imgui_draw.cpp" "${imgui}/imgui_tables.cpp" "${imgui}/imgui_widgets.cpp")
  target_include_directories(yi_ra_ui_test PRIVATE "${imgui}")
  target_compile_definitions(yi_ra_ui_test PRIVATE SDL_MAIN_HANDLED YI_RA_TEST_UI)
  target_link_libraries(yi_ra_ui_test PRIVATE yi_ra_core gdi32)
  if(TARGET SDL2::SDL2)
    target_link_libraries(yi_ra_ui_test PRIVATE SDL2::SDL2)
  else()
    target_include_directories(yi_ra_ui_test PRIVATE ${SDL2_INCLUDE_DIRS})
    target_link_libraries(yi_ra_ui_test PRIVATE ${SDL2_LIBRARIES})
  endif()
  add_test(NAME ra_ui_contract COMMAND yi_ra_ui_test "${CMAKE_CURRENT_BINARY_DIR}/ra-test-popup.bmp")
  foreach(target yi_ra_test yi_ra_ui_test)
    yi_set_link_options(${target})
    if(MSVC)
      target_compile_options(${target} PRIVATE /UNDEBUG)
    else()
      target_compile_options(${target} PRIVATE -UNDEBUG)
    endif()
  endforeach()
endif()

# Synthetic credentials only; exercise secure persistence across two processes.
if(YI_BUILD_TESTS)
  add_executable(ra_persistence_test tests/ra_persistence_test.cpp)
  target_link_libraries(ra_persistence_test PRIVATE yi_ra_core)
  add_test(NAME ra_persistence_write COMMAND ra_persistence_test write)
  set_tests_properties(ra_persistence_write PROPERTIES FIXTURES_SETUP ra_session)
  add_test(NAME ra_persistence_restore COMMAND ra_persistence_test)
  set_tests_properties(ra_persistence_restore PROPERTIES FIXTURES_REQUIRED ra_session)
endif()


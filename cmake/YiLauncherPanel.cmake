# Add host controls below the controller panel of the pinned launcher.
function(yi_launcher_panel target callback)
  get_target_property(original ${target} YI_LAUNCHER_ORIGINAL)
  if(NOT original)
    get_target_property(sources ${target} SOURCES)
    foreach(source IN LISTS sources)
      if(source MATCHES "/launcher_imgui\.cpp$")
        set(original "${source}")
        break()
      endif()
    endforeach()
    if(NOT original)
      message(FATAL_ERROR "Launcher ImGui source was not found")
    endif()
    get_filename_component(backend_dir "${original}" DIRECTORY)
    target_include_directories(${target} PRIVATE "${backend_dir}")
    set_property(TARGET ${target} PROPERTY YI_LAUNCHER_ORIGINAL "${original}")
    list(REMOVE_ITEM sources "${original}")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/yi-launcher/launcher_imgui.cpp")
    set_property(TARGET ${target} PROPERTY SOURCES ${sources} "${generated}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
  endif()
  set_property(TARGET ${target} APPEND PROPERTY YI_LAUNCHER_CALLBACKS "${callback}")
  get_target_property(callbacks ${target} YI_LAUNCHER_CALLBACKS)
  file(READ "${original}" contents)
  set(anchor "    draw_controllers_row(m, *th);")
  string(FIND "${contents}" "${anchor}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Pinned launcher controller panel has changed")
  endif()
  set(calls "${anchor}")
  set(declarations "")
  foreach(draw IN LISTS callbacks)
    string(APPEND declarations "extern \"C\" void ${draw}(const char*);\n")
    string(APPEND calls "\n    ::${draw}(launcher_model_rom_path(m));")
  endforeach()
  string(REPLACE "${anchor}" "${calls}" contents "${contents}")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/yi-launcher")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/yi-launcher/launcher_imgui.cpp" "${declarations}${contents}")
endfunction()

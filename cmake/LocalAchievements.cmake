if(NOT WIN32)
 message(FATAL_ERROR "The local achievements presentation/storage backend currently requires Windows")
endif()
# Offline evaluator only: no rc_client, rapi, hashing, HTTP or credentials.
set(RC_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/vendor/rcheevos-offline")
set(LOCAL_RC_SOURCES)
foreach(part alloc condition condset memref operand trigger value)
 list(APPEND LOCAL_RC_SOURCES "${RC_ROOT}/src/rcheevos/${part}.c")
endforeach()
add_library(yi_local_rules STATIC ${LOCAL_RC_SOURCES} "${RC_ROOT}/src/rc_compat.c" "${RC_ROOT}/src/rc_util.c")
target_include_directories(yi_local_rules PUBLIC "${RC_ROOT}/include" PRIVATE "${RC_ROOT}/src")
target_compile_definitions(yi_local_rules PRIVATE RC_DISABLE_LUA)
add_library(yi_achievements_core STATIC src/achievements/runtime.cpp)
target_link_libraries(yi_achievements_core PUBLIC yi_local_rules)
target_include_directories(yi_achievements_core PUBLIC src/achievements)
if(YI_BUILD_PLAY)
 target_sources(yoshis_island_recomp PRIVATE src/achievements/yi_achievements.cpp)
 target_compile_definitions(yoshis_island_recomp PRIVATE YI_LOCAL_ACHIEVEMENTS=1)
 target_link_libraries(yoshis_island_recomp PRIVATE yi_achievements_core gdi32)
 yi_launcher_panel(yoshis_island_recomp YiAchievementsDrawLauncher)
endif()
if(YI_BUILD_TESTS)
 add_executable(offline_achievements_test tests/offline_achievements_test.cpp)
 target_link_libraries(offline_achievements_test PRIVATE yi_achievements_core)
 yi_set_link_options(offline_achievements_test)
 if(MSVC)
  target_compile_options(offline_achievements_test PRIVATE /UNDEBUG)
 else()
  target_compile_options(offline_achievements_test PRIVATE -UNDEBUG)
 endif()
 add_test(NAME offline_achievements_contract COMMAND offline_achievements_test "${CMAKE_CURRENT_BINARY_DIR}/offline-fixture")
endif()

if(YI_BUILD_TESTS)
 set(imgui "${RECOMP_UI_ROOT}/src/third_party/imgui")
 add_executable(offline_achievements_ui_test tests/offline_achievements_ui_test.cpp src/achievements/yi_achievements.cpp src/rom_profile.c snesrecomp/runner/src/sha256.c snesrecomp/runner/src/crc32.c
  "${imgui}/imgui.cpp" "${imgui}/imgui_draw.cpp" "${imgui}/imgui_tables.cpp" "${imgui}/imgui_widgets.cpp")
 target_include_directories(offline_achievements_ui_test PRIVATE src/achievements snesrecomp/runner/src "${imgui}")
 target_compile_definitions(offline_achievements_ui_test PRIVATE SDL_MAIN_HANDLED)
 if(MSVC)
  target_compile_options(offline_achievements_ui_test PRIVATE /UNDEBUG)
 else()
  target_compile_options(offline_achievements_ui_test PRIVATE -UNDEBUG)
 endif()
 target_link_libraries(offline_achievements_ui_test PRIVATE yi_achievements_core gdi32)
 if(TARGET SDL2::SDL2)
  target_link_libraries(offline_achievements_ui_test PRIVATE SDL2::SDL2)
 else()
  target_include_directories(offline_achievements_ui_test PRIVATE ${SDL2_INCLUDE_DIRS})
  target_link_libraries(offline_achievements_ui_test PRIVATE ${SDL2_LIBRARIES})
 endif()
 yi_set_link_options(offline_achievements_ui_test)
 add_test(NAME offline_achievements_ui_contract COMMAND offline_achievements_ui_test "${CMAKE_CURRENT_BINARY_DIR}/offline-ui-fixture")
endif()
